<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <ProjectReference Include="../../src/WaterMarker.App/WaterMarker.App.csproj" />
    <ProjectReference Include="../WaterMarker.FaultHost/WaterMarker.FaultHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyFaultHost" AfterTargets="Build">
    <ItemGroup><FaultHostFiles Include="../WaterMarker.FaultHost/bin/$(Configuration)/net10.0-windows/**/*" /></ItemGroup>
    <Copy SourceFiles="@(FaultHostFiles)" DestinationFiles="@(FaultHostFiles->'$(OutDir)FaultHost/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
