<Window x:Class="WaterMarker.App.JournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:visuals="clr-namespace:WaterMarker.App.Visuals"
        Title="Journal" Width="1040" Height="620" MinWidth="760" MinHeight="400"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" FontFamily="Segoe UI" FontSize="14" Background="#173F32">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Desk.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <visuals:DeskSurface Padding="18">
        <visuals:LedgerBook Padding="58,18,24,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Journal" FontSize="20" FontFamily="Georgia" Foreground="#34443A" />
                <WrapPanel Grid.Row="1" Margin="0,6">
                    <ComboBox x:Name="FilterInput" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Width="180" Margin="0,0,12,0" AutomationProperties.Name="Filter by project" TabIndex="12" />
                    <Label Content="Code fragment" Target="{Binding ElementName=SearchInput}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchInput" Text="{Binding SearchCode, UpdateSourceTrigger=PropertyChanged}" Width="165" MaxLength="64" AutomationProperties.Name="Search code fragment" TabIndex="13" ToolTip="Type any part of a code, e.g. DZ. Searches all projects as you type.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Clear search" Command="{Binding ClearSearchCommand}" Margin="8,0" TabIndex="14" />
                    <TextBlock Text="{Binding SearchStatus}" VerticalAlignment="Center" Margin="12,0" />
                </WrapPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="JournalGrid" ItemsSource="{Binding Journal}" SelectedItem="{Binding SelectedRecord}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                              Background="{StaticResource LedgerLines}" RowBackground="Transparent" AlternatingRowBackground="#06A58D51" BorderThickness="0"
                              RowHeight="26" ColumnHeaderHeight="26" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#8FA3AB9E" HeadersVisibility="Column"
                              AutomationProperties.Name="Journal records" TabIndex="16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectDisplay}" Width="*" />
                            <DataGridTextColumn Header="Recipient" Binding="{Binding Recipient}" Width="*" />
                            <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="85" />
                            <DataGridTextColumn Header="Exported at" Binding="{Binding ExportedAtDisplay}" Width="130" />
                            <DataGridTextColumn Header="Copy" Binding="{Binding FileName}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox Grid.Column="2" Text="{Binding RecordDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="#CCFBF6E8" BorderBrush="#A8A18B" AutomationProperties.Name="Record details" TabIndex="17" />
                </Grid>
            </Grid>
        </visuals:LedgerBook>
    </visuals:DeskSurface>
</Window>
