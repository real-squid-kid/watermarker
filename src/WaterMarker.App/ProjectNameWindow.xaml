<Window x:Class="WaterMarker.App.ProjectNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:visuals="clr-namespace:WaterMarker.App.Visuals"
        Title="Project" SizeToContent="Height" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#17483B">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Desk.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <visuals:PaperSheet Margin="18" Padding="24,28,24,20">
    <StackPanel>
        <Label Content="Project _name" Target="{Binding ElementName=NameInput}" />
        <TextBox x:Name="NameInput" Padding="8" AutomationProperties.Name="Project name" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,7" Margin="0,0,8,0" />
            <Button Content="Save" IsDefault="True" Click="SaveClick" Padding="16,7" />
        </StackPanel>
    </StackPanel>
    </visuals:PaperSheet>
</Window>
