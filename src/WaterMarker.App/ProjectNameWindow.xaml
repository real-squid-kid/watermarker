<Window x:Class="WaterMarker.App.ProjectNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project" SizeToContent="Height" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F7F3E8">
    <StackPanel Margin="24">
        <Label Content="Project _name" Target="{Binding ElementName=NameInput}" />
        <TextBox x:Name="NameInput" Padding="8" AutomationProperties.Name="Project name" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="16,7" Margin="0,0,8,0" />
            <Button Content="Save" IsDefault="True" Click="SaveClick" Padding="16,7" />
        </StackPanel>
    </StackPanel>
</Window>
