<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:visuals="clr-namespace:WaterMarker.App.Visuals">
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <SolidColorBrush x:Key="Ink" Color="#343C33" />
    <DrawingBrush x:Key="LedgerLines" TileMode="Tile" Viewport="0,0,40,26" ViewportUnits="Absolute" Viewbox="0,0,40,26" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FCF7E8" Geometry="M0,0 H40 V26 H0 Z" />
                <GeometryDrawing Geometry="M0,25.5 H40"><GeometryDrawing.Pen><Pen Brush="#70A3AB9E" Thickness="0.6" /></GeometryDrawing.Pen></GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <LinearGradientBrush x:Key="IvoryKey" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFDF1" Offset="0" />
        <GradientStop Color="#EEE1C3" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="FocusMark" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="#225F93" StrokeThickness="2" StrokeDashArray="2,1" RadiusX="4" RadiusY="4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,2,8,2" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource IvoryKey}" />
        <Setter Property="BorderBrush" Value="#9C8A62" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusMark}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Shadow" Background="#61281F13" CornerRadius="5" Margin="1,3,0,0" />
                        <Border x:Name="Foot" Background="#8B7954" BorderBrush="#4F4B35" BorderThickness="0.7" CornerRadius="5" Margin="0,0,0,1" />
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0.7" CornerRadius="4" Margin="0,0,0,3">
                            <Border BorderBrush="#B9FFFFFF" BorderThickness="1,1,1,0" CornerRadius="3" Margin="1">
                                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#D1AD63" /></Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="RenderTransform"><Setter.Value><TranslateTransform Y="2" /></Setter.Value></Setter>
                            <Setter TargetName="Shadow" Property="Opacity" Value="0.25" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#225F93" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Opacity" Value="0.55" />
                            <Setter TargetName="Foot" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Stamp" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="168" />
        <Setter Property="Height" Value="78" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Grid x:Name="Body" Margin="2" RenderTransformOrigin="0.5,1">
                            <Grid.RenderTransform>
                                <TransformGroup><ScaleTransform /><TranslateTransform /></TransformGroup>
                            </Grid.RenderTransform>
                            <visuals:StampBody x:Name="StampShape" IsHitTestVisible="False" />
                            <ContentPresenter x:Name="StampLabel" Margin="18,0,18,18" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        </Grid>
                        <Border x:Name="Focus" BorderBrush="#FFE3A0" BorderThickness="2" CornerRadius="6" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="RenderTransform"><Setter.Value><TransformGroup><ScaleTransform ScaleY="0.94" /><TranslateTransform Y="4" /></TransformGroup></Setter.Value></Setter>
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard><Storyboard FillBehavior="Stop">
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Body" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="3" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="-1" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard></BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StampShape" Property="Brightness" Value="1.15" />
                            <Setter TargetName="StampLabel" Property="TextElement.Foreground" Value="#3C453B" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Opacity" Value="1" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.8" /><Setter TargetName="StampLabel" Property="Opacity" Value="0.55" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="YellowProgress" TargetType="ProgressBar">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="#8B784D" BorderBrush="#F7E5B1" BorderThickness="1" CornerRadius="6" Padding="3">
                        <Border Background="#292A20" BorderBrush="#50472D" BorderThickness="1,2,1,1" CornerRadius="3" Padding="2">
                            <Grid x:Name="PART_Track" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" BorderBrush="#8D6014" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFF2A0" Offset="0" /><GradientStop Color="#F5CC38" Offset="0.22" />
                                            <GradientStop Color="#DC9F16" Offset="0.6" /><GradientStop Color="#B87B0E" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Border Height="5" VerticalAlignment="Top" Background="#65FFF8C4" Margin="1" CornerRadius="1" />
                                        <Rectangle Opacity="0.3">
                                            <Rectangle.Fill>
                                                <DrawingBrush TileMode="Tile" Viewport="0,0,12,24" ViewportUnits="Absolute">
                                                    <DrawingBrush.Drawing><GeometryDrawing Geometry="M11,0 V24"><GeometryDrawing.Pen><Pen Brush="#826012" Thickness="1" /></GeometryDrawing.Pen></GeometryDrawing></DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="Foreground" Value="#263D39" />
        <Setter Property="Background" Value="#81FFFDF4" />
        <Setter Property="BorderBrush" Value="#A8A18B" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusMark}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Well" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0.6,0.6,0.6,1" CornerRadius="2">
                        <Grid>
                            <Border BorderBrush="#207D7357" BorderThickness="0,1,0,0" Margin="1" IsHitTestVisible="False" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Well" Property="BorderBrush" Value="#225F93" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Well" Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Foreground" Value="#283D36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#E4D6AD" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#D4DDCB" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="Foreground" Value="#263D39" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusMark}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Well" Background="#81FFFDF4" BorderBrush="#A8A18B" BorderThickness="0.6,0.6,0.6,1" CornerRadius="2" />
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="8,5,30,5" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <Border Width="23" HorizontalAlignment="Right" Background="#0B6A5130" BorderBrush="#318D805F" BorderThickness="0.6,0,0,0" Margin="0,2,2,2" CornerRadius="0,2,2,0">
                                            <Path Data="M0,0 L7,0 3.5,4 Z" Fill="#746747" Width="7" Height="4" />
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border Background="#FFF9E8" BorderBrush="#A08B62" BorderThickness="1" CornerRadius="2" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="2">
                                <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Well" Property="BorderBrush" Value="#225F93" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Label">
        <Setter Property="Padding" Value="0,4,0,3" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="#62634E" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#38D8C7A2" />
        <Setter Property="Foreground" Value="#5F6251" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="BorderBrush" Value="#ACB4A6" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Foreground" Value="#36463B" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#3142685A" /><Setter Property="Foreground" Value="#1E3B30" /></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
