<Window x:Class="WaterMarker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:visuals="clr-namespace:WaterMarker.App.Visuals"
        Title="WaterMarker" Width="1120" Height="680" ResizeMode="CanMinimize" SizeToContent="Manual"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" FontFamily="Segoe UI" FontSize="14" Background="#153E32">
    <Window.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Desk.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </Window.Resources>
    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
        <visuals:DeskSurface Width="1088" Height="620" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <Button Content="_Open media" Command="{Binding OpenCommand}" AutomationProperties.Name="Open media" DockPanel.Dock="Left" TabIndex="0" />
                    <Button x:Name="ScreenshotButton" Content="_Screenshot" Command="{Binding CaptureCommand}" AutomationProperties.Name="Screenshot" DockPanel.Dock="Left" TabIndex="1" ToolTip="Select a region on one monitor. Esc cancels." />
                    <Button x:Name="JournalButton" Content="_Journal" Click="OpenJournalClick" DockPanel.Dock="Right" TabIndex="12" />
                    <TextBlock Text="{Binding SourceDisplay}" Foreground="#F5F1E8" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <visuals:PaperSheet Padding="22,26,18,12">
                        <ScrollViewer x:Name="ParametersScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel>
                                <Label Content="_Project" Target="{Binding ElementName=ProjectInput}" />
                                <ComboBox x:Name="ProjectInput" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" AutomationProperties.Name="Project" TabIndex="2" />
                                <WrapPanel>
                                    <Button Content="New project" Command="{Binding NewProjectCommand}" Padding="8,4" FontSize="12" MinHeight="30" TabIndex="3" />
                                    <Button Content="Rename project" Command="{Binding RenameProjectCommand}" Padding="8,4" FontSize="12" MinHeight="30" TabIndex="4" />
                                </WrapPanel>
                                <Label Content="_Recipient" Target="{Binding ElementName=RecipientInput}" />
                                <TextBox x:Name="RecipientInput" Text="{Binding Recipient, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Recipient" TabIndex="5" />
                                <Label Content="_Channel" Target="{Binding ElementName=ChannelInput}" />
                                <ComboBox x:Name="ChannelInput" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" AutomationProperties.Name="Channel" TabIndex="6" />
                                <StackPanel Visibility="{Binding IsOtherChannel, Converter={StaticResource BoolVisibility}}">
                                    <Label Content="Channel name" Target="{Binding ElementName=OtherInput}" />
                                    <TextBox x:Name="OtherInput" Text="{Binding OtherChannel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Channel name" TabIndex="7" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </visuals:PaperSheet>
                    <visuals:TelevisionHost x:Name="TelevisionHost" Grid.Column="2" AspectRatio="{Binding TelevisionAspectRatio}" UseLayoutRounding="False">
                        <visuals:TelevisionCase x:Name="Television" UseLayoutRounding="False" AllowDrop="True"
                                                PreviewDragOver="TelevisionDragOver" DragLeave="TelevisionDragLeave" PreviewDrop="TelevisionDrop">
                            <Grid x:Name="ScreenAperture" Background="Black" UseLayoutRounding="False">
                                <visuals:TelevisionIdle x:Name="NoSignal" IsHitTestVisible="False">
                                    <visuals:TelevisionIdle.Style>
                                        <Style TargetType="visuals:TelevisionIdle">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding Preview}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </visuals:TelevisionIdle.Style>
                                </visuals:TelevisionIdle>
                                <Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="Uniform" UseLayoutRounding="False" AutomationProperties.Name="Watermark preview" />
                            </Grid>
                        </visuals:TelevisionCase>
                    </visuals:TelevisionHost>
                </Grid>
                <DockPanel Grid.Row="2" Margin="0,2">
                    <Button x:Name="WatermarkButton" Content="_Watermark" Command="{Binding WatermarkCommand}" Style="{StaticResource Stamp}" TabIndex="8" />
                    <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}" Visibility="{Binding IsExporting, Converter={StaticResource BoolVisibility}}" TabIndex="9" VerticalAlignment="Center" />
                    <Button Content="Open file" Command="{Binding OpenFileCommand}" VerticalAlignment="Center" TabIndex="10" />
                    <Button Content="Open folder" Command="{Binding OpenFolderCommand}" VerticalAlignment="Center" TabIndex="11" />
                    <StackPanel VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="{Binding Status}" Foreground="#FFF5D7" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,5,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </visuals:DeskSurface>
    </Viewbox>
</Window>
