<Window x:Class="WaterMarker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaterMarker" Width="1240" Height="860" MinWidth="880" MinHeight="700"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,4,8,4" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,12,0,5" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch">
        <Border BorderBrush="#6D8577" BorderThickness="1" Padding="22" MinHeight="720"
                Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1C4033" Offset="0" />
                    <GradientStop Color="#315E49" Offset="0.55" />
                    <GradientStop Color="#1A392F" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="270" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0.85*" MinHeight="230" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Button Content="_Open image" Command="{Binding OpenCommand}" AutomationProperties.Name="Open image" DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding SourceDisplay}" Foreground="#F5F1E8" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#F5F0E2" BorderBrush="#D2C8AC" BorderThickness="1" Padding="20,8,20,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Label Content="_Project" Target="{Binding ElementName=ProjectInput}" />
                                <ComboBox x:Name="ProjectInput" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" AutomationProperties.Name="Project" />
                                <WrapPanel>
                                    <Button Content="New project" Command="{Binding NewProjectCommand}" Padding="8,5" FontSize="12" />
                                    <Button Content="Rename project" Command="{Binding RenameProjectCommand}" Padding="8,5" FontSize="12" />
                                </WrapPanel>
                                <Label Content="_Recipient" Target="{Binding ElementName=RecipientInput}" />
                                <TextBox x:Name="RecipientInput" Text="{Binding Recipient, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Recipient" />
                                <Label Content="_Channel" Target="{Binding ElementName=ChannelInput}" />
                                <ComboBox x:Name="ChannelInput" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" AutomationProperties.Name="Channel" />
                                <StackPanel Visibility="{Binding IsOtherChannel, Converter={StaticResource BoolVisibility}}">
                                    <Label Content="Channel name" Target="{Binding ElementName=OtherInput}" />
                                    <TextBox x:Name="OtherInput" Text="{Binding OtherChannel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Channel name" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="2" Background="#262A29" BorderBrush="#5C625E" BorderThickness="10" CornerRadius="16" Padding="6">
                        <Grid Background="#101412">
                            <Image Source="{Binding Preview}" Stretch="Uniform" AutomationProperties.Name="Watermark preview" />
                        </Grid>
                    </Border>
                </Grid>
                <DockPanel Grid.Row="2" Margin="0,12">
                    <Button Content="_Watermark" Command="{Binding WatermarkCommand}" FontSize="17" FontWeight="SemiBold" Padding="24,10" Background="#E3B67A" Foreground="#302C27" />
                    <Button Content="Open file" Command="{Binding OpenFileCommand}" />
                    <Button Content="Open folder" Command="{Binding OpenFolderCommand}" />
                    <StackPanel VerticalAlignment="Center" Margin="12,0">
                        <TextBlock Text="{Binding Status}" Foreground="#FFF5D7" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,5,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="3" Background="#F5F0E2" BorderBrush="#D2C8AC" BorderThickness="1" Padding="16,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Journal" FontSize="20" FontWeight="SemiBold" />
                        <WrapPanel Grid.Row="1" Margin="0,6">
                            <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Width="180" Margin="0,0,12,0" AutomationProperties.Name="Filter by project" />
                            <TextBox Text="{Binding SearchCode, UpdateSourceTrigger=PropertyChanged}" Width="165" MaxLength="64" AutomationProperties.Name="Search code">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Content="Search code" Command="{Binding SearchCommand}" Margin="8,0" />
                            <Button Content="Show journal" Command="{Binding RefreshJournalCommand}" Margin="0" />
                            <TextBlock Text="{Binding SearchStatus}" VerticalAlignment="Center" Margin="12,0" />
                        </WrapPanel>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DataGrid ItemsSource="{Binding Journal}" SelectedItem="{Binding SelectedRecord}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                                      Background="#FFFBF1" RowBackground="#FFFBF1" AlternatingRowBackground="#F2EDDE"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#D9D5C6" HeadersVisibility="Column"
                                      AutomationProperties.Name="Journal records">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Project" Binding="{Binding ProjectDisplay}" Width="*" />
                                    <DataGridTextColumn Header="Recipient" Binding="{Binding Recipient}" Width="*" />
                                    <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="85" />
                                    <DataGridTextColumn Header="Exported at" Binding="{Binding ExportedAtDisplay}" Width="130" />
                                    <DataGridTextColumn Header="Copy" Binding="{Binding FileName}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBox Grid.Column="2" Text="{Binding RecordDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Background="#FFFBF1" AutomationProperties.Name="Record details" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </ScrollViewer>
</Window>
